<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- Black outer border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#000000" />
                </shape>
            </item>
            <!-- Face (pushed) -->
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#2c2c2c" />
                </shape>
            </item>
            <!-- Inset shadow when pressed -->
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#1a1a1a" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Black outer border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#000000" />
                </shape>
            </item>
            <!-- Top/Left Highlight -->
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#666666" />
                </shape>
            </item>
            <!-- Bottom/Right Dark Shadow -->
            <item android:bottom="1dp" android:left="2dp" android:right="1dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1a1a1a" />
                </shape>
            </item>
            <!-- Button Face -->
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#3c3c3c" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
