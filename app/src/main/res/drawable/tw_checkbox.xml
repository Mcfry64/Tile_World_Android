<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CHECKED -->
    <item android:state_checked="true">
        <layer-list>

            <!-- Black outer border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#000000" />
                    <size
                        android:width="16dp"
                        android:height="16dp" />
                </shape>
            </item>

            <!-- Gray border -->
            <item
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#808080" />
                </shape>
            </item>

            <!-- White inner area -->
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>

            <!-- Centered X -->
            <item
                android:left="3dp"
                android:top="3dp"
                android:right="3dp"
                android:bottom="3dp">

                <vector
                    android:width="10dp"
                    android:height="10dp"
                    android:viewportWidth="10"
                    android:viewportHeight="10">

                    <path
                        android:fillColor="#000000"
                        android:pathData="
                            M1,0
                            L0,1
                            L4,5
                            L0,9
                            L1,10
                            L5,6
                            L9,10
                            L10,9
                            L6,5
                            L10,1
                            L9,0
                            L5,4
                            Z" />

                </vector>
            </item>

        </layer-list>
    </item>


    <!-- UNCHECKED -->
    <item>
        <layer-list>

            <!-- Black outer border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#000000" />
                    <size
                        android:width="16dp"
                        android:height="16dp" />
                </shape>
            </item>

            <!-- Gray border -->
            <item
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#808080" />
                </shape>
            </item>

            <!-- White inner area -->
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>

        </layer-list>
    </item>

</selector>