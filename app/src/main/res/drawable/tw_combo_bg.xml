<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <!-- Outer black border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#000000" />
                </shape>
            </item>
            <!-- Dark background for the text area -->
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1e1e1e" />
                </shape>
            </item>

            <!-- The Arrow Button on the right -->
            <item android:gravity="right" android:width="22dp">
                <layer-list>
                    <!-- Button face border -->
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#000000" />
                        </shape>
                    </item>
                    <!-- Button face -->
                    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                        <shape android:shape="rectangle">
                            <solid android:color="#3c3c3c" />
                        </shape>
                    </item>
                    <!-- Top/Left Highlight -->
                    <item android:bottom="2dp" android:left="1dp" android:right="2dp" android:top="1dp">
                        <shape android:shape="rectangle">
                            <stroke android:width="1dp" android:color="#666666" />
                        </shape>
                    </item>
                    <!-- Bottom/Right Shadow -->
                    <item android:bottom="1dp" android:left="2dp" android:right="1dp" android:top="2dp">
                        <shape android:shape="rectangle">
                            <stroke android:width="1dp" android:color="#1a1a1a" />
                        </shape>
                    </item>
                    <!-- The Triangle (Arrow Down) -->
                    <item android:gravity="center" android:drawable="@drawable/tw_arrow_down" />
                </layer-list>
            </item>
        </layer-list>
    </item>
</selector>
