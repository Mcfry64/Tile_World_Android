<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer black border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>
    <!-- Frame background (Dark Gray) -->
    <item android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#3c3c3c" />
        </shape>
    </item>
    <!-- Top/Left Highlights (Subtle) -->
    <item android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#666666" />
        </shape>
    </item>
</layer-list>
