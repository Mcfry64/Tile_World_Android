<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_launcher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    tools:ignore="HardcodedText,RtlSymmetry">

    <!-- Top spacer matching the 50dp game button row height -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:color/transparent" />

    <!-- Scrollable Container for the unified window -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">

        <!-- FUSED WINDOW: Tile World Launcher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:background="@drawable/tw_window"
            android:orientation="vertical"
            android:padding="3dp">

                    <!-- Title Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:background="@drawable/tw_title_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="6dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Tile World Icon"
                            android:src="@drawable/chipnotrace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Tile World Launcher"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Content -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#2c2c2c"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Audio Section (Top) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="24dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:text="Audio:"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:layout_marginEnd="8dp" />

                                <FrameLayout
                                    android:layout_width="0dp"
                                    android:layout_height="22dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/tw_field">

                                    <TextView
                                        android:id="@+id/text_audio_marquee"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center_vertical|end"
                                        android:fontFamily="monospace"
                                        android:textColor="#00FF00"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:singleLine="true"
                                        android:ellipsize="marquee"
                                        android:marqueeRepeatLimit="marquee_forever"
                                        android:focusable="true"
                                        android:focusableInTouchMode="true"
                                        android:paddingStart="4dp"
                                        android:paddingEnd="4dp"
                                        android:text="+++ ♪ AKI — Demoscene legend since 1994. ♫ Discover her music: YT▶ @aki_128 ☕ ko-fi.com/aki128 +++" />
                                </FrameLayout>
                            </LinearLayout>

                            <!-- BGM Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_marginBottom="4dp">

                                <TextView
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:gravity="center"
                                    android:fontFamily="monospace"
                                    android:background="@drawable/tw_field"
                                    android:layout_marginEnd="4dp"
                                    android:text="BGM"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <SeekBar
                                    android:id="@+id/sb_bgm_volume"
                                    android:layout_width="0dp"
                                    android:layout_height="28dp"
                                    android:layout_weight="1.3"
                                    android:layout_marginEnd="8dp"
                                    android:max="100"
                                    android:progress="100"
                                    android:progressDrawable="@drawable/tw_seekbar_track"
                                    android:thumb="@drawable/tw_seekbar_thumb"
                                    android:splitTrack="false"
                                    android:paddingStart="15dp"
                                    android:paddingEnd="15dp"
                                    android:paddingTop="0dp"
                                    android:paddingBottom="0dp"
                                    android:minHeight="28dp"
                                    android:maxHeight="28dp" />

                                <Spinner
                                    android:id="@+id/spinner_bgm_theme"
                                    android:layout_width="0dp"
                                    android:layout_height="34dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/tw_combo_bg"
                                    android:overlapAnchor="false"
                                    android:paddingEnd="26dp"
                                    android:popupBackground="@drawable/tw_popup"
                                    android:spinnerMode="dropdown" />
                            </LinearLayout>

                            <!-- SFX Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:clipChildren="false"
                                android:clipToPadding="false">

                                <FrameLayout
                                    android:id="@+id/btn_sfx_toggle"
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:layout_marginEnd="4dp"
                                    android:background="@drawable/tw_button"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <TextView
                                        android:id="@+id/tv_sfx_label"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:fontFamily="monospace"
                                        android:text="SFX"
                                        android:textColor="#FFFFFF"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <ImageView
                                        android:id="@+id/iv_sfx_zigzags"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="SFX Assist Indicator"
                                        android:scaleType="fitCenter"
                                        android:src="@drawable/ic_sfx_haptic_only"
                                        android:visibility="gone" />
                                </FrameLayout>

                                <SeekBar
                                    android:id="@+id/sb_sfx_volume"
                                    android:layout_width="0dp"
                                    android:layout_height="28dp"
                                    android:layout_weight="1.3"
                                    android:layout_marginEnd="8dp"
                                    android:max="100"
                                    android:progress="100"
                                    android:progressDrawable="@drawable/tw_seekbar_track"
                                    android:thumb="@drawable/tw_seekbar_thumb"
                                    android:splitTrack="false"
                                    android:paddingStart="15dp"
                                    android:paddingEnd="15dp"
                                    android:paddingTop="0dp"
                                    android:paddingBottom="0dp"
                                    android:minHeight="28dp"
                                    android:maxHeight="28dp" />

                                <Spinner
                                    android:id="@+id/spinner_sfx_theme"
                                    android:layout_width="0dp"
                                    android:layout_height="34dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/tw_combo_bg"
                                    android:overlapAnchor="false"
                                    android:paddingEnd="26dp"
                                    android:popupBackground="@drawable/tw_popup"
                                    android:spinnerMode="dropdown" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Controls Section -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_marginBottom="4dp">

                                <!-- Column 1: Swipe / Touch Style (Left) -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.3"
                                    android:layout_marginEnd="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="3dp"
                                        android:fontFamily="monospace"
                                        android:text="Touchscreen Controls:"
                                        android:textColor="#FFFFFF"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                    <Spinner
                                        android:id="@+id/spinner_swipe_style"
                                        android:layout_width="match_parent"
                                        android:layout_height="34dp"
                                        android:background="@drawable/tw_combo_bg"
                                        android:overlapAnchor="false"
                                        android:paddingEnd="26dp"
                                        android:popupBackground="@drawable/tw_popup"
                                        android:spinnerMode="dropdown" />
                                </LinearLayout>

                                <!-- Column 2: Onscreen Controls (Right) -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="3dp"
                                        android:fontFamily="monospace"
                                        android:text="Onscreen Controls:"
                                        android:textColor="#FFFFFF"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                    <Spinner
                                        android:id="@+id/spinner_onscreen_controls"
                                        android:layout_width="match_parent"
                                        android:layout_height="34dp"
                                        android:background="@drawable/tw_combo_bg"
                                        android:overlapAnchor="false"
                                        android:paddingEnd="26dp"
                                        android:popupBackground="@drawable/tw_popup"
                                        android:spinnerMode="dropdown" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/text_swipe_desc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:text="Smooth continuous turns without lifting finger."
                                android:textColor="#C0C0C0"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Ruleset & Tileset (Side-by-Side in Middle) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <!-- Ruleset Section -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="3dp"
                                    android:fontFamily="monospace"
                                    android:text="Ruleset:"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <!-- Ruleset Toggle Button -->
                                    <FrameLayout
                                        android:id="@+id/btn_ruleset_toggle"
                                        android:layout_width="50dp"
                                        android:layout_height="40dp"
                                        android:layout_marginEnd="6dp"
                                        android:background="@drawable/tw_button"
                                        android:clickable="true"
                                        android:focusable="true">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:gravity="center"
                                            android:orientation="vertical">

                                            <TextView
                                                android:id="@+id/tv_ruleset_lynx"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:fontFamily="monospace"
                                                android:includeFontPadding="false"
                                                android:text="LYNX"
                                                android:textColor="#888888"
                                                android:textSize="12sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/tv_ruleset_ms"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:fontFamily="monospace"
                                                android:includeFontPadding="false"
                                                android:text="MS"
                                                android:textColor="#00FF00"
                                                android:textSize="12sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>
                                    </FrameLayout>

                                    <!-- Pixel-Perfect Toggle Button -->
                                    <FrameLayout
                                        android:id="@+id/btn_pixel_perfect_toggle"
                                        android:layout_width="42dp"
                                        android:layout_height="40dp"
                                        android:background="@drawable/tw_button"
                                        android:clickable="true"
                                        android:focusable="true">

                                        <TextView
                                            android:id="@+id/tv_pixel_perfect_label"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:gravity="center"
                                            android:fontFamily="monospace"
                                            android:text="1:1"
                                            android:textColor="#888888"
                                            android:textSize="14sp"
                                            android:textStyle="bold" />
                                    </FrameLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Tileset Section -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="3dp"
                                    android:fontFamily="monospace"
                                    android:text="Tileset:"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <!-- Dropdown Spinners -->
                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="34dp">

                                    <Spinner
                                        android:id="@+id/spinner_ms_tiles"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@drawable/tw_combo_bg"
                                        android:overlapAnchor="false"
                                        android:paddingEnd="26dp"
                                        android:popupBackground="@drawable/tw_popup"
                                        android:spinnerMode="dropdown"
                                        android:visibility="visible" />

                                    <Spinner
                                        android:id="@+id/spinner_lynx_tiles"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@drawable/tw_combo_bg"
                                        android:overlapAnchor="false"
                                        android:paddingEnd="26dp"
                                        android:popupBackground="@drawable/tw_popup"
                                        android:spinnerMode="dropdown"
                                        android:visibility="gone" />
                                </FrameLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Level Set Section (Bottom) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="3dp"
                                android:fontFamily="monospace"
                                android:text="Level Set:"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinner_sets"
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:background="@drawable/tw_combo_bg"
                                android:overlapAnchor="false"
                                android:paddingEnd="26dp"
                                android:popupBackground="@drawable/tw_popup"
                                android:spinnerMode="dropdown" />
                        </LinearLayout>

                        <!-- Select Level Section -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="3dp"
                                android:fontFamily="monospace"
                                android:text="Select Level:"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:orientation="horizontal">

                                <ImageButton
                                    android:id="@+id/btn_password"
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/tw_button"
                                    android:contentDescription="Enter Password"
                                    android:padding="7dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_password_lock" />

                                <Spinner
                                    android:id="@+id/spinner_levels"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@drawable/tw_combo_bg"
                                    android:overlapAnchor="false"
                                    android:paddingEnd="26dp"
                                    android:popupBackground="@drawable/tw_popup"
                                    android:spinnerMode="dropdown" />
                            </LinearLayout>

                            <!-- SCORES button + Progress Bar below Select Level dropdown -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="26dp"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageButton
                                    android:id="@+id/btn_see_scores"
                                    android:layout_width="38dp"
                                    android:layout_height="26dp"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/tw_button"
                                    android:contentDescription="Level Scores"
                                    android:padding="5dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_trophy" />

                                <FrameLayout
                                    android:layout_width="0dp"
                                    android:layout_height="26dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/tw_field"
                                    android:padding="1dp">

                                    <ProgressBar
                                        android:id="@+id/progress_set"
                                        style="?android:attr/progressBarStyleHorizontal"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:max="100"
                                        android:progress="0"
                                        android:progressDrawable="@drawable/progress_bar_blue" />

                                    <TextView
                                        android:id="@+id/text_progress_overlay"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical|start"
                                        android:fontFamily="monospace"
                                        android:paddingStart="8dp"
                                        android:text="Progress: 0/0"
                                        android:textColor="#FFFFFF"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </FrameLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_start"
                            android:layout_width="150dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/tw_button"
                            android:fontFamily="monospace"
                            android:padding="0dp"
                            android:text="START GAME"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- Game Speed Section (Hidden by default, unlocked by 10s hold on START GAME) -->
                        <LinearLayout
                            android:id="@+id/container_game_speed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="8dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="3dp"
                                android:fontFamily="monospace"
                                android:text="Game Speed:"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinner_game_speed"
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:background="@drawable/tw_combo_bg"
                                android:overlapAnchor="false"
                                android:paddingEnd="26dp"
                                android:popupBackground="@drawable/tw_popup"
                                android:spinnerMode="dropdown" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:gravity="center"
                                android:text="Hold START GAME 10s again to disable"
                                android:textColor="#C0C0C0"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Hidden legacy tileset spinner -->
                        <Spinner
                            android:id="@+id/spinner_tilesets"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                    </LinearLayout>
                </LinearLayout>
        </ScrollView>

    <!-- Bottom spacer matching the 50dp game bottom spacer height -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:color/transparent" />

</LinearLayout>
